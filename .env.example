# MAKEEN FM Portal — web environment (copy to web/.env.local for dev).
# On the web server, set these as real environment variables. Never commit .env files.

NODE_ENV=development

# Where this server forwards /api/* — the API server's PRIVATE address (server-side only, never sent
# to the browser). Dev: the local API. Production example: http://10.0.1.20:4000
API_INTERNAL_URL=http://localhost:4000

# Opt out of Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1
